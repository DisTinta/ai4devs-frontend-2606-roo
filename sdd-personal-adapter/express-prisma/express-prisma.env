# Adaptador personal — Express + Prisma + React CRA (monorepo frontend/ + backend/)
# Unit tests mock Prisma: CMD_TEST does not require Docker. Runtime and migrations do.
STACK="express-prisma"

CMD_TEST="npm --prefix backend test"
CMD_TEST_FILTER="npm --prefix backend test --"
CMD_LINT=""
CMD_FORMAT_FILE="npx --prefix backend prettier --write"
CMD_STATIC_FILE=""
CMD_STATIC="npx --prefix backend tsc --noEmit"
CMD_MUTATION=""
CMD_DOCS_COVERAGE=""
CMD_DEV="npm --prefix backend run dev"
CMD_MIGRATE="npx --prefix backend prisma migrate deploy"

SOURCE_EXTENSIONS="ts tsx js jsx"
PATH_SOURCE="backend/src"
PATH_TESTS="backend/src"
PATH_BUSINESS="backend/src/application"
PATH_HTTP="backend/src/presentation"
PATH_MIGRATIONS="backend/prisma/migrations"
PATH_ADR="docs/adr"

# Business layer must not import Express transport types.
GUARD_HTTP_IN_BUSINESS="from[[:space:]]+['\"]express['\"]|Request[[:space:]]*,[[:space:]]*Response|NextFunction"
# HTTP layer must not talk to Prisma / raw SQL directly.
GUARD_DB_IN_HTTP="PrismaClient|@prisma/client|prisma\.|SELECT[[:space:]]|INSERT[[:space:]]+INTO|UPDATE[[:space:]]+[a-z_]+[[:space:]]+SET"
# Destructive Docker / SQL — blocks volume wipe and DROP.
GUARD_DANGEROUS_CMD="docker[[:space:]]+compose[[:space:]]+down[[:space:]]+.*-v|docker-compose[[:space:]]+down[[:space:]]+.*-v|DROP[[:space:]]+(DATABASE|TABLE|SCHEMA)|prisma[[:space:]]+migrate[[:space:]]+reset"

LAYER_ORDER="test → domain model → application service → controller → route"
MIN_MUTATION_SCORE="70"
BRANCH_PREFIX="feature/"
KIT_SKIP_STOP_TESTS="0"
KIT_ALLOW_WIP="0"
